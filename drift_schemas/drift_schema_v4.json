  "fixed_sql": [
    {
      "name": "medications",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"medications\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"dosage\" TEXT NULL, \"is_active\" INTEGER NOT NULL DEFAULT 1 CHECK (\"is_active\" IN (0, 1)), \"created_at\" INTEGER NOT NULL, CHECK (length(trim(name)) > 0));"
        }
      ]
    },
    {
      "name": "medication_details",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"medication_details\" (\"medication_id\" INTEGER NOT NULL REFERENCES medications (id) ON DELETE CASCADE, \"starts_on\" INTEGER NOT NULL, \"name\" TEXT NOT NULL, \"dosage\" TEXT NULL, PRIMARY KEY (\"medication_id\", \"starts_on\"));"
        }
      ]
    },
    {
      "name": "medication_schedules",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"medication_schedules\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"medication_id\" INTEGER NOT NULL REFERENCES medications (id) ON DELETE RESTRICT, \"recurrence\" INTEGER NOT NULL, \"minutes_after_midnight\" INTEGER NULL, \"starts_on\" INTEGER NOT NULL, \"ends_before\" INTEGER NULL, \"label\" TEXT NULL, CHECK (recurrence BETWEEN 0 AND 127), CHECK (minutes_after_midnight BETWEEN 0 AND 1439), CHECK (ends_before >= starts_on));"
        }
      ]
    },
    {
      "name": "intake_events",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"intake_events\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"schedule_id\" INTEGER NOT NULL REFERENCES medication_schedules (id) ON DELETE RESTRICT, \"scheduled_date\" INTEGER NOT NULL, \"kind\" TEXT NOT NULL, \"recorded_at\" INTEGER NOT NULL, \"recorded_on\" INTEGER NULL, \"reported_intake_at\" INTEGER NULL, CHECK (kind IN ('confirmation', 'correction')), CHECK (kind = 'confirmation' OR reported_intake_at IS NULL));"
        }
      ]
    },
    {
      "name": "slot_reminders",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"slot_reminders\" (\"schedule_id\" INTEGER NOT NULL REFERENCES medication_schedules (id) ON DELETE CASCADE, \"enabled\" INTEGER NOT NULL CHECK (\"enabled\" IN (0, 1)), \"reminder_minute\" INTEGER NULL, \"snooze_minutes\" INTEGER NOT NULL, \"changed_at\" INTEGER NOT NULL, PRIMARY KEY (\"schedule_id\"), CHECK (reminder_minute BETWEEN 0 AND 1439), CHECK (snooze_minutes BETWEEN 1 AND 120));"
        }
      ]
    },
    {
      "name": "reminder_occurrences",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"reminder_occurrences\" (\"schedule_id\" INTEGER NOT NULL REFERENCES medication_schedules (id) ON DELETE CASCADE, \"scheduled_date\" INTEGER NOT NULL, \"snoozed_until\" INTEGER NULL, \"action_token\" TEXT NULL, \"latest_event_id\" INTEGER NOT NULL, PRIMARY KEY (\"schedule_id\", \"scheduled_date\"));"
        }
      ]
    },
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"id\" INTEGER NOT NULL DEFAULT 1, \"theme_mode\" TEXT NOT NULL, \"accent\" TEXT NOT NULL, \"language\" TEXT NOT NULL, PRIMARY KEY (\"id\"), CHECK (id = 1), CHECK (theme_mode IN ('system', 'light', 'dark')), CHECK (accent IN ('green', 'blue', 'teal', 'orange', 'purple', 'red')), CHECK (language IN ('de', 'en')));"
        }
      ]
    },
    {
      "name": "schedules_by_medication",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX schedules_by_medication ON medication_schedules (medication_id, starts_on)"
        }
      ]
    },
    {
      "name": "events_by_intake",
      "sql": [
